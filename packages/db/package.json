{
  "name": "@reelforge/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./test-utils": "./src/test-utils.ts"
  },
  "scripts": {
    "generate": "node ../../scripts/with-root-env.mjs prisma generate",
    "migrate:dev": "node ../../scripts/with-root-env.mjs prisma migrate dev",
    "migrate:deploy": "node ../../scripts/with-root-env.mjs prisma migrate deploy",
    "seed": "node ../../scripts/with-root-env.mjs tsx src/seed.ts",
    "sync-schemas": "tsx src/schema-sync.ts write",
    "check-schemas": "tsx src/schema-sync.ts check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@reelforge/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
