# Reelforge environment catalogue.
# Copy to .env and adjust. Precedence: real environment > .env > .env.defaults (committed).
# The dev profile boots with NO .env at all — .env.defaults covers it.

# ── Database ────────────────────────────────────────────────────────────────
# Dev/test (SQLite): file:./.data/dev.db  (relative paths resolve against repo root)
# Production (Postgres): postgresql://USER:PASS@HOST:5432/reelforge?schema=public
#   → use packages/db/prisma/schema.postgres.prisma (see README "Production").
DATABASE_URL="file:./.data/dev.db"

# ── Auth.js ─────────────────────────────────────────────────────────────────
# Generate a real one for production: `openssl rand -base64 32`
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
# Google OAuth (optional; the provider button appears only when both are set)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Dev only: write the latest magic link to .data/dev/magic-links.json and expose
# GET /api/dev/magic-link?email=… (blocked when NODE_ENV=production)
AUTH_DEV_MAGIC_LINK="1"
# Production email delivery for magic links (SMTP). When set, links are emailed
# instead of logged. Leave empty in dev.
EMAIL_SERVER=""
EMAIL_FROM="Reelforge <signin@example.com>"

# ── Queue ───────────────────────────────────────────────────────────────────
# db     = poll/claim on the jobs table (dev default; zero infra)
# bullmq = BullMQ on Redis (production)   memory = unit tests only
QUEUE_DRIVER="db"
REDIS_URL="redis://localhost:6379"

# ── Storage ─────────────────────────────────────────────────────────────────
# local = .data/storage served via authenticated route (dev default)
# s3    = S3/R2 with signed URLs (production)
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT=".data/storage"
S3_ENDPOINT=""            # e.g. https://<account>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_BUCKET="reelforge"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="1"   # R2/minio: 1, AWS: 0
S3_SIGNED_URL_TTL_SECONDS="900"

# ── Video provider ──────────────────────────────────────────────────────────
# mock = MockProvider (dev default)   pds-cli = real PDS CLI (needs local verification,
# see docs/pds-cli-notes.md + docs/LOCAL-VERIFY.md)
VIDEO_PROVIDER="mock"
# MockProvider knobs
MOCK_MIN_MS="3000"
MOCK_MAX_MS="7000"
MOCK_FAILURE_RATE="0"     # 0..1 random failures (deterministic trigger: prompt containing [force-fail])
# PdsCliProvider knobs (all required for VIDEO_PROVIDER=pds-cli)
PDS_API_URL="https://video.promptdriven.ai"
PDS_TOKEN=""              # agent token rawToken; scopes: project:create,project:read,project:write,pipeline:run,artifact:read
PDS_BIN="pds"             # path to the pds binary (npm i -g @promptdriven/pds)
PDS_PIPELINE_TARGET="render"   # VERIFY LOCALLY before first paid run (docs/LOCAL-VERIFY.md)
PDS_WORKDIR=".data/pds"

# ── Worker ──────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY="2"
WORKER_POLL_MS="1000"
WORKER_SHUTDOWN_GRACE_MS="20000"
PROVIDER_TIMEOUT_MS="900000"   # hard per-job timeout (15 min default)
PROVIDER_MAX_RETRIES="2"       # bounded provider retries with backoff

# ── Stripe ──────────────────────────────────────────────────────────────────
# Test mode: sk_test_… / pk_test_… + a webhook endpoint for checkout.session.completed.
# Dev sandbox (no network): DEV_FAKE_CHECKOUT=1 posts a correctly-signed synthetic event
# to the real webhook route instead of calling Stripe. Never enable in production.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET="whsec_change_me"
DEV_FAKE_CHECKOUT="1"

# ── Product economics / safety ──────────────────────────────────────────────
SIGNUP_BONUS_CREDITS="0"
RATE_LIMIT_JOBS_PER_MINUTE="6"
ADMIN_EMAILS=""           # comma-separated; these accounts get the admin role at sign-in
