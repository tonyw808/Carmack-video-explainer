# Committed dev-profile defaults. Loaded LAST (never overrides .env or real env vars).
# Every value here is safe for local/sandbox development only. See .env.example for the
# full catalogue and production guidance.

DATABASE_URL="file:./.data/dev.db"

AUTH_SECRET="reelforge-dev-only-auth-secret-do-not-use-in-prod"
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
AUTH_DEV_MAGIC_LINK="1"

QUEUE_DRIVER="db"
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT=".data/storage"
VIDEO_PROVIDER="mock"

MOCK_MIN_MS="3000"
MOCK_MAX_MS="7000"
MOCK_FAILURE_RATE="0"

WORKER_CONCURRENCY="2"
WORKER_POLL_MS="1000"
WORKER_SHUTDOWN_GRACE_MS="20000"
PROVIDER_TIMEOUT_MS="900000"

DEV_FAKE_CHECKOUT="1"
STRIPE_WEBHOOK_SECRET="whsec_reelforge_dev_fixture_secret"

SIGNUP_BONUS_CREDITS="0"
RATE_LIMIT_JOBS_PER_MINUTE="6"
ADMIN_EMAILS=""
