{
  "name": "reelforge",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @reelforge/web dev",
    "dev:worker": "pnpm --filter @reelforge/worker dev",
    "build": "pnpm --filter @reelforge/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "pnpm --filter @reelforge/web e2e",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:generate": "pnpm --filter @reelforge/db generate",
    "db:migrate": "pnpm --filter @reelforge/db migrate:dev",
    "db:seed": "pnpm --filter @reelforge/db seed",
    "db:check-schemas": "pnpm --filter @reelforge/db check-schemas"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@tailwindcss/oxide",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
